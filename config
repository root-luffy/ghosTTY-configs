# ============================================================================
#  Ghostty — tuned config (1.3.x)
# ============================================================================

# ===== FONT =====
# Primary stays FantasqueSansM (your pick). To switch to the JetBrains stack,
# comment the two Fantasque lines and uncomment the JetBrains block below.
font-family = FantasqueSansM Nerd Font Mono
font-family-italic = Victor Mono
# font-family = JetBrainsMono Nerd Font
# font-family-italic = Victor Mono
font-size = 13
adjust-cell-height = 12%
font-feature = liga
font-feature = calt
font-feature = ss01
font-thicken = true
font-thicken-strength = 40
font-synthetic-style = true

# ===== RENDERING QUALITY =====
minimum-contrast = 1.05
alpha-blending = linear-corrected

# ===== BACKGROUND IMAGE =====
# wallpaper.conf is generated by `ghostty-wallpaper` (~/.local/bin), which
# rolls a random image from ~/Pictures/ghostty (install.sh symlinks that to
# wallpapers/ in this repo, so it's populated from the start). It runs on
# every new shell, so each window you open gets a fresh one; ctrl+shift+r
# re-reads it in the current window. Pin one with `ghostty-wallpaper --set
# FILE`, turn it off with `ghostty-wallpaper --off`. The `?` means "skip if
# missing".
config-file = ?wallpaper.conf

# ===== WINDOW =====
# Opaque on purpose: with a background image, window transparency stacks the
# desktop *and* whatever window is behind Ghostty underneath your text, which is
# what made the file-manager labels bleed through. The wallpaper is the texture
# now. Set back to 0.92 if you want the see-through look instead.
background-opacity = 1.0
background-blur = false
window-height = 34
window-width = 120
window-theme = dark
window-decoration = auto
window-save-state = always
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-padding-color = background
window-inherit-working-directory = true
window-inherit-font-size = true
window-new-tab-position = current
confirm-close-surface = false
gtk-single-instance = true
gtk-tabs-location = top
title = GhosTTY

# ===== CURSOR =====
cursor-style = bar
cursor-style-blink = true
adjust-cursor-thickness = 2
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# ===== SELECTION / CLIPBOARD =====
copy-on-select = true
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
link-url = true

# ===== SPLITS =====
unfocused-split-opacity = 0.7
unfocused-split-fill = #0d1117

# ===== SHELL / SCROLLBACK =====
scrollback-limit = 10000000
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ===== QUICK DROPDOWN TERMINAL =====
quick-terminal-position = top
quick-terminal-animation-duration = 0.18
quick-terminal-autohide = true

# ===== SHADERS (off by default — glow.glsl was blurring text; swap to crt.glsl for retro) =====
# custom-shader = shaders/glow.glsl
custom-shader-animation = false
# custom-shader = shaders/crt.glsl

# ===== KEYBINDS =====
keybind = ctrl+backquote=toggle_quick_terminal
# splits
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+minus=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+enter=toggle_split_zoom
# tabs / overview / config
keybind = ctrl+shift+o=toggle_tab_overview
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+comma=open_config

# ===== THEME: Neon Tokyo =====
background = #0d1117
foreground = #c8d3f5
cursor-color = #ff7eff
cursor-text = #0d1117
selection-background = #2d3f76
selection-foreground = #ffffff

# normal
palette = 0=#15161e
palette = 1=#ff5d8f
palette = 2=#9ece6a
palette = 3=#ffd866
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#c8d3f5

# bright
palette = 8=#414868
palette = 9=#ff7eb6
palette = 10=#b9f27c
palette = 11=#ffe28a
palette = 12=#9bb8ff
palette = 13=#d3aaff
palette = 14=#a9e9ff
palette = 15=#ffffff

resize-overlay = never
